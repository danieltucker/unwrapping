{
  "name": "unwrap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:parse && npm run test:handles && npm run test:santa && npm run test:santa-privacy && npm run test:santa-flow && npm run test:events && npm run test:prices && npm run test:sort",
    "test:parse": "node scripts/test-parse.mts",
    "test:handles": "node scripts/test-handles.mts",
    "test:santa": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/app-loader.mjs scripts/test-santa.mts",
    "test:santa-privacy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/app-loader.mjs scripts/test-santa-privacy.mts",
    "test:santa-flow": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/app-loader.mjs scripts/test-santa-flow.mts",
    "test:events": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/app-loader.mjs scripts/test-events.mts",
    "test:prices": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/app-loader.mjs scripts/test-prices.mts",
    "test:sort": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/app-loader.mjs scripts/test-sort.mts",
    "check": "npm run typecheck && npm run lint && npm test",
    "scrape": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/scrape-url.mts",
    "prices:audit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audit-prices.mts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.5",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
