# Copy to .env.local for development, or to .env next to docker-compose.yml for
# a self-hosted instance. See docs/self-hosting.md.

# SQLite file. The path is relative to the working directory. The container
# overrides this to /app/data/app.db, which is the mounted volume.
DATABASE_URL=file:./data/app.db

# Signs session and guest cookies. Any long random string; changing it signs
# everyone out and orphans existing guest reservations.
# Generate one: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The address this instance is reached on, scheme and port included. It appears
# in share links, canonical URLs and link previews, and it decides whether
# cookies may be marked Secure, so an http address has to say http.
# Unset means https://unwrapp.ing, which is only right for the real site.
# SITE_URL=http://nas.local:3000

# Who may open /admin: the accounts-lists-photos screen, where deleting is
# immediate and permanent. Comma-separated email addresses, matched against the
# address an account signed up with. Unset means nobody, and the screen 404s for
# everyone — including you, until you put yourself here and restart. Anyone
# named here can make other accounts admins from the screen, and can't
# themselves be removed or banned from it.
# ADMIN_EMAILS=you@example.com

# Secret Santa's switch. Change it and restart; no rebuild is needed.
# "on" (the default), "readonly" (pages open and people can still see who
# they drew, but nothing can be created, joined, drawn or messaged), or "off"
# (every /secret-santa page 404s and the links to it disappear; nothing is
# deleted). Anything else counts as off. See docs/secret-santa-launch.md.
# SECRET_SANTA=on

# Event tracking: list views, gift impressions and clicks through to shops,
# shown in the Tracking section of /admin. On unless this says "off"; anything
# unrecognised also counts as off. On, buy buttons go through /go/<id> to count
# the click, and visitors get a random
# first-party id cookie (13 months) and session cookie (30 idle minutes). No
# names, emails, IPs or user agents are stored, Do Not Track is honoured, and
# raw events are deleted after 13 months. Change it and restart; /admin also
# has a pause switch that needs no restart. See docs/event-tracking.md.
# EVENT_TRACKING=off

# The price filter on public lists and gift-list shelves: Under $25 and the
# other chips, a custom range, and ?min=&max=&unpriced= in the address. On
# unless this says "off"; anything unrecognised also counts as off. Off, the bar
# is gone and a filtered link opens unfiltered. Change it and restart.
# PRICE_FILTER=off

# The sort on public lists and gift-list shelves: owner's order, most wanted or
# top picks first, price either way, newest and A to Z, kept as ?sort= in the
# address. On unless this says "off"; anything unrecognised also counts as off.
# Off, the select leaves the filter bar, a sorted link opens in the owner's
# order, and a list's grid gets back its old in-page sort. Change it and restart.
# GIFT_SORT=off

# Applies pending migrations when the server starts. On by default in
# production, because a container has no drizzle-kit and nobody to run it.
# Set to 0 to manage migrations yourself with `npm run db:migrate`.
# DB_AUTO_MIGRATE=1

# Rechecks product links in the background, about once a month each, so prices
# taken from the shop stay current and dead links get flagged in the editor and
# on /admin. On by default in production, off in development so a laptop isn't
# fetching shops unasked. Set to 1 to turn it on anywhere, 0 to turn it off.
# PRICE_CHECKS=1
# How many links each hourly batch checks, and how many days a link is left
# alone after a check.
# PRICE_CHECK_BATCH=20
# PRICE_CHECK_DAYS=30

# Every attempt to read a product page already logs one line. Set this to 1 to
# also log the whole trace as JSON and keep each page body under data/scrapes/,
# so a shop that stopped filling in can be worked on offline. Off by default:
# product pages are megabytes each and nothing prunes them.
# See "When a shop link won't fill in" in docs/self-hosting.md.
# SCRAPE_DEBUG=1

# The port on the host that docker-compose publishes the container on. Read by
# docker-compose.yml only, never by the app: inside the container the server
# always listens on 3000. Behind a Cloudflare Tunnel this is just the address
# cloudflared points at, so pick anything free and keep SITE_URL as the public
# https domain.
# APP_PORT=3000
