# Copy to .env.local for development, or to .env next to docker-compose.yml for
# a self-hosted instance. See docs/self-hosting.md.

# SQLite file. The path is relative to the working directory. The container
# overrides this to /app/data/app.db, which is the mounted volume.
DATABASE_URL=file:./data/app.db

# Signs session and guest cookies. Any long random string; changing it signs
# everyone out and orphans existing guest reservations.
# Generate one: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The address this instance is reached on, scheme and port included. It appears
# in share links, canonical URLs and link previews, and it decides whether
# cookies may be marked Secure, so an http address has to say http.
# Unset means https://unwrapp.ing, which is only right for the real site.
# SITE_URL=http://nas.local:3000

# Who may open /admin: the accounts-lists-photos screen, where deleting is
# immediate and permanent. Comma-separated email addresses, matched against the
# address an account signed up with. Unset means nobody, and the screen 404s for
# everyone — including you, until you put yourself here and restart.
# ADMIN_EMAILS=you@example.com

# Applies pending migrations when the server starts. On by default in
# production, because a container has no drizzle-kit and nobody to run it.
# Set to 0 to manage migrations yourself with `npm run db:migrate`.
# DB_AUTO_MIGRATE=1

# Every attempt to read a product page already logs one line. Set this to 1 to
# also log the whole trace as JSON and keep each page body under data/scrapes/,
# so a shop that stopped filling in can be worked on offline. Off by default:
# product pages are megabytes each and nothing prunes them.
# See "When a shop link won't fill in" in docs/self-hosting.md.
# SCRAPE_DEBUG=1

# The port on the host that docker-compose publishes the container on. Read by
# docker-compose.yml only, never by the app: inside the container the server
# always listens on 3000. Behind a Cloudflare Tunnel this is just the address
# cloudflared points at, so pick anything free and keep SITE_URL as the public
# https domain.
# APP_PORT=3000
